{
  "name": "absensi-desktop",
  "version": "1.0.0",
  "description": "Aplikasi laporan absensi siswa - export ke Microsoft Excel",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.absensi.desktop",
    "productName": "Absensi MM BJN Timur",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "node_modules"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}